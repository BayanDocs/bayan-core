    "KeysPressCase": {
      "description": "A key press, with whether a shell sends it and what the engine does with it (spec §14.3).",
      "type": "object",
      "properties": {
        "id": {
          "description": "The case's identifier: lower-case letters and digits, words joined by hyphens. It is never reused; a removed case's identifier goes into `removed`.",
          "type": "string"
        },
        "description": {
          "description": "What the case shows, in words.",
          "type": "string"
        },
        "for": {
          "description": "`shell`: both shells send the press as `input.key` exactly when `send` says; `engine`: the engine runs what `runs` says.",
          "type": "array",
          "items": {
            "enum": [
              "engine",
              "shell"
            ]
          }
        },
        "manifest": {
          "description": "The identifier of the manifest case whose key data apply.",
          "type": "string"
        },
        "layout": {
          "description": "The keyboard layout the press comes from, for people: `us`, `fr`, `de`, `ar`, `ru`, `ja` or `zh`.",
          "type": "string"
        },
        "press": {
          "description": "The press as `input.key` would carry it.",
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "ctrl": {
              "type": "boolean"
            },
            "shift": {
              "type": "boolean"
            },
            "alt": {
              "type": "boolean"
            },
            "meta": {
              "type": "boolean"
            },
            "composing": {
              "type": "boolean"
            }
          },
          "required": [
            "key",
            "code",
            "ctrl",
            "shift",
            "alt",
            "meta",
            "composing"
          ],
          "additionalProperties": false
        },
        "expect": {
          "type": "object",
          "properties": {
            "send": {
              "type": "boolean"
            },
            "runs": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "command": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "command"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "document_key": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "document_key"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "send",
            "runs"
          ],
          "additionalProperties": false
        }
