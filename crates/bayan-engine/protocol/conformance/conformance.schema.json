    "TextState": {
      "description": "The text of the node that holds the caret, as the engine shows it, and its selection (spec §14.4): in v1's mock document its editable line, node 5, whose first heading is node 2, which is not editable. Offsets count UTF-16 code units.",
      "type": "object",
      "properties": {
        "node": {
          "description": "The node.",
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "description": "Its committed text.",
          "type": "string"
